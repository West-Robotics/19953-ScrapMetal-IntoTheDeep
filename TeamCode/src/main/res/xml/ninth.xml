<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Control Hub" port="173">
            <goBILDA5202SeriesMotor name="frontRight" port="0" />
            <goBILDA5202SeriesMotor name="backRight"  port="1" />
            <goBILDA5202SeriesMotor name="backLeft"   port="2" />
            <goBILDA5202SeriesMotor name="frontLeft"  port="3" />
            <goBILDAPinpoint        name="pinpoint"   port="0" bus="0" />
            <DigitalDevice          name="color0"     port="0" />
            <DigitalDevice          name="color1"     port="1" />
            <!-- <RevColorSensorV3 name="Color" port="3" /> --> <!-- uncomment this to configure Brushland sensor -->
            <Servo name="pto" port="0" />
        </LynxModule>
        <LynxModule name="Expansion Hub 1" port="1">
            <goBILDA5202SeriesMotor name="rightLift"  port="0" />
            <goBILDA5202SeriesMotor name="leftLift"   port="1" />
        </LynxModule>
        <LynxModule name="Servo Hub 3" port="3">
            <Servo  name="frontExt"    port="0" />
            <Servo  name="backExt"     port="1" />
            <Servo  name="proximal"    port="2" />
            <Servo  name="distal"      port="3" />
            <Servo  name="roll"        port="4" />
            <Servo  name="claw"        port="5" />
        </LynxModule>
    </LynxUsbDevice>
    <EthernetDevice name="limelight" serialNumber="EthernetOverUsb:eth0:172.29.0.28" port="0" ipAddress="172.29.0.1" />
</Robot>